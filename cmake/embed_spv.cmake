# Generates a C++ file with every *.spv in SPV_DIR as a uint32_t array plus a lookup table.
file(GLOB _files "${SPV_DIR}/*.spv")
list(SORT _files)
set(_content "// Generated by cmake/embed_spv.cmake - do not edit.\n#include <cstddef>\n#include <cstdint>\n#include <cstring>\nnamespace gtabr { namespace gfx {\n")
set(_table "")
set(_idx 0)
foreach(_f ${_files})
  get_filename_component(_n "${_f}" NAME)
  file(READ "${_f}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _bytes "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
  string(APPEND _content "alignas(4) static const unsigned char kSpv${_idx}[] = {${_arr}};\n")
  string(APPEND _table "  {\"${_n}\", kSpv${_idx}, ${_bytes}},\n")
  math(EXPR _idx "${_idx} + 1")
endforeach()
string(APPEND _content "struct SpvEntry { const char* name; const unsigned char* data; size_t size; };\nstatic const SpvEntry kTable[] = {\n${_table}};\n")
string(APPEND _content "bool findEmbeddedShader(const char* name, const uint32_t** code, size_t* sizeBytes) {\n  for (const SpvEntry& e : kTable) if (!std::strcmp(e.name, name)) { *code = reinterpret_cast<const uint32_t*>(e.data); *sizeBytes = e.size; return true; }\n  return false;\n}\n}}\n")
file(WRITE "${OUT}" "${_content}")
